# ============================================================
# 数字命理推演引擎 — 生产环境变量模板
# 使用：cp .env.example .env → nano .env → docker compose up -d
# ============================================================

# ═══════════════════════════════════════
# LLM Provider（选一个）
# ═══════════════════════════════════════
# 可选值: deepseek | openai | claude | local
LLM_PROVIDER=deepseek

# ═══════════════════════════════════════
# API Key（填你的 Key）
# ═══════════════════════════════════════
LLM_API_KEY=sk-your-api-key-here

# ═══════════════════════════════════════
# API Base URL（按 Provider 填写）
# ═══════════════════════════════════════
# DeepSeek:  https://api.deepseek.com/v1
# OpenAI:    https://api.openai.com/v1
# Claude:    https://api.anthropic.com/v1
# Local:     http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# ═══════════════════════════════════════
# 模型名（按 Provider 填写）
# ═══════════════════════════════════════
# DeepSeek:  deepseek-chat
# OpenAI:    gpt-4o
# Claude:    claude-sonnet-4-20250514
# Local:     qwen2.5:7b
LLM_MODEL=deepseek-chat

# ═══════════════════════════════════════
# 生成参数（可选）
# ═══════════════════════════════════════
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096

# ═══════════════════════════════════════
# 服务器端口 / 监听地址
# ═══════════════════════════════════════
SERVER_PORT=3001
# 监听地址：Docker 部署保持默认 0.0.0.0（容器内必须是 0.0.0.0，否则端口映射失效）；
# 不想让公网直连 3001 时，请改 docker-compose.yml 的 ports 为 "127.0.0.1:3001:3001"
# SERVER_HOST=0.0.0.0

# ═══════════════════════════════════════
# 数据库（SQLite 文件路径，容器内为 /app/data/mingli.db）
# ⚠️ 必须落在已挂载的数据卷内，否则容器重建会丢用户/订单数据
# ═══════════════════════════════════════
DB_PATH=data/mingli.db

# ═══════════════════════════════════════
# 安全密钥（生产务必改成随机值，勿用默认）
# 生成：openssl rand -hex 32
# ═══════════════════════════════════════
# 后台管理员登录密码（默认 mingli2026）
ADMIN_PASSWORD=change-me-please
# 后台会话 JWT 密钥（默认 mingli-admin-secret-change-me）
ADMIN_JWT_SECRET=replace-with-openssl-rand-hex-32
# C 端用户令牌密钥（默认 mingli-user-secret-change-me）
USER_JWT_SECRET=replace-with-openssl-rand-hex-32

# ═══════════════════════════════════════
# 日志（生产环境推荐开启）
# ═══════════════════════════════════════
LOG_ENABLED=true
LOG_LEVEL=info
# LOG_DIR=./logs
